      <div class="feature-panels">
        <section class="feature-panel active" id="feature-music" role="tabpanel" aria-labelledby="tab-music" data-feature-panel="music">
          <div class="panel-title"><div><span class="panel-kicker">KONTROL MEDIA SISTEM</span><h3>Musik</h3></div><span class="equalizer" aria-hidden="true">▂ ▅ ▃ ▇ ▄ ▆</span></div>
          <div class="track-card"><div class="album-art">♫</div><div class="track-copy"><strong id="trackTitle">Demo track</strong><span id="trackArtist">BRAMO radio · preview lokal</span><i class="track-progress"><b id="trackProgress"></b></i></div></div>
          <div class="media-actions"><button type="button" data-track="previous" aria-label="Lagu sebelumnya">⏮</button><button class="media-play" id="musicToggle" type="button" aria-label="Putar demo">▶</button><button type="button" data-track="next" aria-label="Lagu berikutnya">⏭</button><span id="musicState" aria-live="polite">Kontrol musik contoh</span></div>
