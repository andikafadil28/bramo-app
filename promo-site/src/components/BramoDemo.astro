<script>
  const stage=document.querySelector('#demoStage');const buddy=document.querySelector('#demoBuddy');const bubble=document.querySelector('#demoBubble');const status=document.querySelector('#demoStatus');const eyes=document.querySelectorAll('.demo-eye');const stateButtons=document.querySelectorAll('[data-demo-state]');const colorButtons=document.querySelectorAll('[data-demo-color]');const panelToggle=document.querySelector('#panelToggle');const panel=document.querySelector('#demoPanel');const toggleState=document.querySelector('#toggleState');const tabButtons=document.querySelectorAll('[data-panel-tab]');const panelContents=document.querySelectorAll('[data-panel-content]');
  const stateCopy={idle:['Lagi santai','Hai! Arahkan kursor ke visor, ya 👀'],focus:['Lagi fokus','Oke, kita fokus bareng dulu ✨'],music:['Lagi menikmati musik','Lagu ini enak juga 🎵'],dizzy:['Lagi pusing','Jangan digoyang terus dong 😵‍💫']};let bubbleTimer;let focusTimer;let seconds=25*60;let playing=false;let xp=280;
  function showDemoMessage(message,duration=2600){bubble.textContent=message;bubble.classList.add('show');clearTimeout(bubbleTimer);if(duration)bubbleTimer=setTimeout(()=>bubble.classList.remove('show'),duration)}
  stateButtons.forEach(button=>button.addEventListener('click',()=>{const state=button.dataset.demoState;stage.dataset.state=state;status.textContent=stateCopy[state][0];stateButtons.forEach(item=>item.classList.toggle('active',item===button));showDemoMessage(stateCopy[state][1])}));
  colorButtons.forEach(button=>button.addEventListener('click',()=>{stage.style.setProperty('--demo-led',button.dataset.demoColor);colorButtons.forEach(item=>item.classList.toggle('active',item===button));showDemoMessage(`Glow ${button.getAttribute('aria-label')} dipilih ✨`,1800)}));
  stage.addEventListener('pointermove',event=>{const bounds=stage.getBoundingClientRect();const x=Math.max(-5,Math.min(5,((event.clientX-bounds.left)/bounds.width-.5)*10));const y=Math.max(-3,Math.min(3,((event.clientY-bounds.top)/bounds.height-.5)*6));eyes.forEach((eye,index)=>{eye.style.setProperty('--gaze-x',`${x+(index?0.4:-0.4)}px`);eye.style.setProperty('--gaze-y',`${y}px`)})});stage.addEventListener('pointerleave',()=>eyes.forEach(eye=>{eye.style.setProperty('--gaze-x','0px');eye.style.setProperty('--gaze-y','0px')}));buddy.addEventListener('click',()=>showDemoMessage('Hehe, makasih udah nyapa! 🤖'));
  panelToggle.addEventListener('click',()=>{const open=panelToggle.getAttribute('aria-expanded')==='true';panelToggle.setAttribute('aria-expanded',String(!open));panel.hidden=open;toggleState.textContent=open?'Buka panel⌄':'Tutup panel⌃'});
  tabButtons.forEach(button=>button.addEventListener('click',()=>{tabButtons.forEach(tab=>{const active=tab===button;tab.classList.toggle('active',active);tab.setAttribute('aria-selected',String(active))});panelContents.forEach(content=>{content.hidden=content.dataset.panelContent!==button.dataset.panelTab})}));
  document.querySelectorAll('[data-music-action]').forEach(button=>button.addEventListener('click',()=>{const action=button.dataset.musicAction;const message=document.querySelector('#musicMessage');if(action==='play'){playing=!playing;button.textContent=playing?'Ⅱ':'▶';button.setAttribute('aria-label',playing?'Jeda musik demo':'Putar musik demo');message.textContent=playing?'Memutar demo track':'Musik dijeda'}else message.textContent=action==='next'?'Demo track berikutnya':'Demo track sebelumnya';stage.dataset.state='music';status.textContent='Lagi menikmati musik'}));
  function renderFocus(){const min=Math.floor(seconds/60).toString().padStart(2,'0');const sec=(seconds%60).toString().padStart(2,'0');document.querySelector('#focusTime').textContent=`${min}:${sec}`;document.querySelector('#focusProgress').style.width=`${((25*60-seconds)/(25*60))*100}%`}
  document.querySelector('#focusStart').addEventListener('click',event=>{if(focusTimer){clearInterval(focusTimer);focusTimer=null;event.currentTarget.textContent='Lanjutkan';document.querySelector('#focusMessage').textContent='Sesi dijeda'}else{event.currentTarget.textContent='Jeda sesi';document.querySelector('#focusMessage').textContent='Timer simulasi berjalan';focusTimer=setInterval(()=>{seconds=Math.max(0,seconds-1);renderFocus();if(seconds===0){clearInterval(focusTimer);focusTimer=null;event.currentTarget.textContent='Mulai lagi';document.querySelector('#focusMessage').textContent='Sesi demo selesai ✨'}},1000)}});
  document.querySelector('#focusReset').addEventListener('click',()=>{clearInterval(focusTimer);focusTimer=null;seconds=25*60;document.querySelector('#focusStart').textContent='Mulai sesi';document.querySelector('#focusMessage').textContent='Simulasi Pomodoro';renderFocus()});
  document.querySelectorAll('[data-tool]').forEach(button=>button.addEventListener('click',()=>showDemoMessage(`Pintasan ${button.dataset.tool} di demo ✨`)));
  document.querySelector('#xpEarn').addEventListener('click',()=>{xp=Math.min(400,xp+10);document.querySelector('#xpCount').textContent=String(xp);document.querySelector('#xpBar').style.width=`${xp/4}%`;if(xp===400)document.querySelector('#xpEarn').disabled=true;showDemoMessage('+10 XP buat BRAMO! ✨')});
</script>
