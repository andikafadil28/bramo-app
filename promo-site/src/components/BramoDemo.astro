        <button class="feature-tab" role="tab" id="tab-launcher" aria-selected="false" aria-controls="feature-launcher" data-feature-tab="launcher" type="button"><i>⌁</i><span>Launcher</span></button>
        <button class="feature-tab" role="tab" id="tab-break" aria-selected="false" aria-controls="feature-break" data-feature-tab="break" type="button"><i>🌿</i><span>Pengingat Jeda</span></button>
        <button class="feature-tab" role="tab" id="tab-prayer" aria-selected="false" aria-controls="feature-prayer" data-feature-tab="prayer" type="button"><i>☪</i><span>Pengingat Sholat</span></button>
