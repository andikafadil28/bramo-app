          <div class="sub-tabs" role="tablist" aria-label="Demo tugas atau alarm"><button class="sub-tab active" id="subTasks" type="button" data-todo-view="tasks" aria-selected="true">Tugas</button><button class="sub-tab" id="subAlarm" type="button" data-todo-view="alarm" aria-selected="false">Bangun tidur</button></div>
          <div class="todo-view" id="todoTasks"><form id="todoForm" class="todo-form"><input id="todoInput" type="text" maxlength="48" placeholder="Tugas berikutnya…" aria-label="Tugas baru" required /><button class="action-primary" type="submit">Tambah</button></form><div class="todo-list" id="todoList"><label><input type="checkbox" /><span>Selesaikan satu hal penting</span><small>Demo</small></label></div><p class="panel-hint">Pengingat tugas asli berjalan selama BRAMO aktif.</p></div>
          <div class="todo-view" id="todoAlarm" hidden><div class="alarm-clock">07:00 <span>Besok pagi</span></div><label class="switch-row alarm-switch"><input id="alarmEnabled" type="checkbox" /><span class="switch"></span><b>Alarm harian</b></label><div class="weekday-list"><span>Sen</span><span>Sel</span><span>Rab</span><span>Kam</span><span>Jum</span><span>Sab</span><span>Min</span></div><div class="reminder-actions"><button class="action-primary" id="alarmTest" type="button">Tes suara</button><button class="action-secondary" id="alarmSnooze" type="button">Tunda 5 menit</button></div><p class="panel-hint">Simulasi tampilan alarm; tidak memasang alarm pada PC.</p></div>
        </section>

        <section class="feature-panel" id="feature-journey" role="tabpanel" aria-labelledby="tab-journey" data-feature-panel="journey" hidden>
          <div class="panel-title"><div><span class="panel-kicker">TEMANI BRAMO TUMBUH</span><h3>Journey &amp; Koleksi</h3></div><span class="level-pill">LV 4</span></div>
          <div class="sub-tabs" role="tablist" aria-label="Demo perjalanan atau koleksi"><button class="sub-tab active" type="button" data-journey-view="journey" aria-selected="true">Perjalanan</button><button class="sub-tab" type="button" data-journey-view="collection" aria-selected="false">Koleksi</button></div>
          <div class="journey-view" id="journeyProgress"><div class="xp-summary"><span>XP TERKUMPUL</span><strong><b id="xpCount">280</b> / 400 XP</strong></div><i class="xp-progress"><b id="xpBar"></b></i><div class="accessory-current"><span id="activeAccessoryIcon">🤠</span><div><small>AKSESORI AKTIF</small><strong id="activeAccessory">Topi Koboi</strong></div><button type="button" data-journey-view="collection">Ganti</button></div><div class="xp-actions"><button class="action-primary" id="earnXp" type="button">Simulasikan +10 XP</button><span>XP &amp; aksesori terpisah</span></div></div>
          <div class="journey-view collection-view" id="journeyCollection" hidden><div class="cosmetic-group"><strong>Bentuk mata</strong><div class="choice-row"><button class="choice-chip selected" data-look="eyes" data-value="led" type="button">LED</button><button class="choice-chip" data-look="eyes" data-value="pixel" type="button">Pixel</button><button class="choice-chip" data-look="eyes" data-value="spiral" type="button">Spiral</button></div></div><div class="cosmetic-group"><strong>Bentuk mulut</strong><div class="choice-row"><button class="choice-chip selected" data-look="mouth" data-value="smile" type="button">Senyum</button><button class="choice-chip" data-look="mouth" data-value="flat" type="button">Datar</button><button class="choice-chip" data-look="mouth" data-value="mumble" type="button">Pixel</button></div></div><div class="cosmetic-group"><strong>Warna glow</strong><div class="collection-colors"><button type="button" aria-label="Cyan" data-demo-color="#51f7e4" style="--swatch:#51f7e4"></button><button type="button" aria-label="Matrix Green" data-demo-color="#70ed9b" style="--swatch:#70ed9b"></button><button type="button" aria-label="Neon Pink" data-demo-color="#ff65d4" style="--swatch:#ff65d4"></button><button type="button" aria-label="Amber" data-demo-color="#ffad52" style="--swatch:#ffad52"></button></div></div><div class="accessory-grid"><button type="button" data-accessory="Topi Koboi" data-icon="🤠">🤠<span>Topi Koboi</span></button><button type="button" data-accessory="Mahkota Pixel" data-icon="👑">👑<span>Mahkota Pixel</span></button><button type="button" data-accessory="Halo Neon" data-icon="✨">✨<span>Halo Neon</span></button></div><p class="panel-hint">Koleksi adalah kosmetik; XP-mu tidak berkurang saat ganti aksesori.</p></div>
        </section>

        <section class="feature-panel" id="feature-settings" role="tabpanel" aria-labelledby="tab-settings" data-feature-panel="settings" hidden>
