<script>
  const stage=document.querySelector('#demoStage');const mover=document.querySelector('#buddyMover');const buddy=document.querySelector('#demoBuddy');const bubble=document.querySelector('#demoBubble');const status=document.querySelector('#demoStatus');const gazeEyes=document.querySelectorAll('[data-gaze-eye]');let bubbleTimer;let dragState=null;let dragged=false;
  const expressions={idle:['Lagi santai','Hai! Arahkan kursor ke visor, ya 👀'],focus:['Lagi fokus','Oke, kita fokus bareng dulu ✨'],music:['Lagi menikmati musik','Lagu ini enak juga 🎵'],dizzy:['Lagi pusing','Jangan digoyang terus dong 😵‍💫'],sleep:['Lagi tidur','Ssst… aku lagi istirahat sebentar 💤']};
  function say(message,duration=2600){bubble.textContent=message;bubble.classList.add('show');clearTimeout(bubbleTimer);if(duration)bubbleTimer=setTimeout(()=>bubble.classList.remove('show'),duration)}
  function setExpression(state,message){stage.dataset.state=state;status.textContent=expressions[state]?.[0]??state;if(message)say(message)}
  document.querySelectorAll('[data-demo-state]').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll('[data-demo-state]').forEach(item=>item.classList.toggle('active',item===button));setExpression(button.dataset.demoState,expressions[button.dataset.demoState][1])}));
  document.querySelectorAll('[data-demo-color]').forEach(button=>button.addEventListener('click',()=>{stage.style.setProperty('--demo-led',button.dataset.demoColor);document.querySelectorAll('[data-demo-color]').forEach(item=>item.classList.toggle('active',item===button));say(`Glow ${button.getAttribute('aria-label')} dipilih ✨`,1800)}));
  stage.addEventListener('pointermove',event=>{const bounds=stage.getBoundingClientRect();const x=Math.max(-5,Math.min(5,((event.clientX-bounds.left)/bounds.width-.5)*10));const y=Math.max(-3,Math.min(3,((event.clientY-bounds.top)/bounds.height-.5)*6));gazeEyes.forEach((eye,index)=>{eye.style.setProperty('--gaze-x',`${x+(index%2?0.4:-0.4)}px`);eye.style.setProperty('--gaze-y',`${y}px`)})});stage.addEventListener('pointerleave',()=>gazeEyes.forEach(eye=>{eye.style.setProperty('--gaze-x','0px');eye.style.setProperty('--gaze-y','0px')}));
  mover.addEventListener('pointerdown',event=>{if(event.button!==0)return;const box=mover.getBoundingClientRect();const bounds=stage.getBoundingClientRect();dragState={pointerId:event.pointerId,startX:event.clientX,startY:event.clientY,offsetX:event.clientX-(box.left+box.width/2),offsetY:event.clientY-(box.top+box.height/2),bounds,width:box.width,height:box.height};dragged=false;mover.setPointerCapture(event.pointerId)});
  mover.addEventListener('pointermove',event=>{if(!dragState||dragState.pointerId!==event.pointerId)return;const dx=event.clientX-dragState.startX;const dy=event.clientY-dragState.startY;if(Math.hypot(dx,dy)>4){dragged=true;mover.classList.add('dragging');const x=event.clientX-dragState.bounds.left-dragState.offsetX;const y=event.clientY-dragState.bounds.top-dragState.offsetY;const halfW=dragState.width/2;const halfH=dragState.height/2;mover.style.left=`${Math.max(halfW,Math.min(dragState.bounds.width-halfW,x))}px`;mover.style.top=`${Math.max(halfH,Math.min(dragState.bounds.height-halfH,y))}px`;mover.style.transition='none'}});
  function endDrag(){if(!dragState)return;dragState=null;mover.classList.remove('dragging');setTimeout(()=>{dragged=false},0)}mover.addEventListener('pointerup',endDrag);mover.addEventListener('pointercancel',endDrag);mover.addEventListener('click',event=>{if(dragged){event.preventDefault();return}say('Makasih udah nyapa! Coba geser aku atau buka menu di bawah 👋')});
  const featureTabs=document.querySelectorAll('[data-feature-tab]');const featurePanels=document.querySelectorAll('[data-feature-panel]');featureTabs.forEach(tab=>tab.addEventListener('click',()=>{featureTabs.forEach(item=>{const active=item===tab;item.classList.toggle('active',active);item.setAttribute('aria-selected',String(active))});featurePanels.forEach(panel=>{const active=panel.dataset.featurePanel===tab.dataset.featureTab;panel.hidden=!active;panel.classList.toggle('active',active)})}));
  let trackIndex=0;let playing=false;const tracks=[['Demo track','BRAMO radio · preview lokal'],['Fokus mode','BRAMO focus mix'],['Pixel sunset','BRAMO radio · preview lokal']];document.querySelectorAll('[data-track]').forEach(button=>button.addEventListener('click',()=>{trackIndex=(trackIndex+(button.dataset.track==='next'?1:tracks.length-1))%tracks.length;document.querySelector('#trackTitle').textContent=tracks[trackIndex][0];document.querySelector('#trackArtist').textContent=tracks[trackIndex][1];document.querySelector('#musicState').textContent='Lagu demo diganti'}));document.querySelector('#musicToggle').addEventListener('click',event=>{playing=!playing;event.currentTarget.textContent=playing?'Ⅱ':'▶';event.currentTarget.setAttribute('aria-label',playing?'Jeda demo':'Putar demo');document.querySelector('#musicState').textContent=playing?'Memutar contoh saja':'Demo dijeda';if(playing)setExpression('music')});
  let focusSeconds=25*60;let focusTimer=null;let focusSession='focus';function renderFocus(){const mins=String(Math.floor(focusSeconds/60)).padStart(2,'0');const secs=String(focusSeconds%60).padStart(2,'0');document.querySelector('#focusTime').textContent=`${mins}:${secs}`;const total=(Number(document.querySelector('#focusLength').value)||25)*60;document.querySelector('#focusProgress').style.width=`${Math.max(0,Math.min(100,(1-focusSeconds/total)*100))}%`}
  function resetFocus(){clearInterval(focusTimer);focusTimer=null;focusSession='focus';focusSeconds=Number(document.querySelector('#focusLength').value)*60;document.querySelector('#focusMode').textContent='FOCUS SESSION';document.querySelector('#focusToggle').textContent='Mulai fokus';document.querySelector('#focusHint').textContent='Timer demo dipercepat: 30 detik simulasi per detik.';renderFocus()}document.querySelector('#focusLength').addEventListener('change',resetFocus);document.querySelector('#focusReset').addEventListener('click',resetFocus);document.querySelector('#focusToggle').addEventListener('click',event=>{if(focusTimer){clearInterval(focusTimer);focusTimer=null;event.currentTarget.textContent='Lanjutkan';document.querySelector('#focusHint').textContent='Sesi dijeda'}else{event.currentTarget.textContent='Jeda sesi';document.querySelector('#focusHint').textContent='Timer simulasi berjalan';setExpression('focus');focusTimer=setInterval(()=>{focusSeconds=Math.max(0,focusSeconds-30);renderFocus();if(focusSeconds===0){clearInterval(focusTimer);focusTimer=null;if(focusSession==='focus'){focusSession='break';focusSeconds=Number(document.querySelector('#breakLength').value)*60;document.querySelector('#focusMode').textContent='BREAK SESSION';document.querySelector('#focusToggle').textContent='Mulai jeda';document.querySelector('#focusHint').textContent='Sesi fokus demo selesai. Saatnya jeda.';say('Sesi fokus selesai. Istirahat sebentar, yuk! ☕')}else{focusSession='focus';focusSeconds=Number(document.querySelector('#focusLength').value)*60;document.querySelector('#focusMode').textContent='FOCUS SESSION';document.querySelector('#focusToggle').textContent='Mulai fokus';document.querySelector('#focusHint').textContent='Sesi jeda demo selesai.'}renderFocus()}},1000)}});
  const dropZone=document.querySelector('#dropZone');const filePicker=document.querySelector('#filePicker');function showFile(file){if(file)document.querySelector('#fileStatus').textContent=`${file.name} · ${(file.size/1024).toFixed(0)} KB (tidak diunggah)`}filePicker.addEventListener('change',()=>showFile(filePicker.files?.[0]));['dragenter','dragover'].forEach(name=>dropZone.addEventListener(name,event=>{event.preventDefault();dropZone.classList.add('drag-over')}));['dragleave','drop'].forEach(name=>dropZone.addEventListener(name,event=>{event.preventDefault();dropZone.classList.remove('drag-over')}));dropZone.addEventListener('drop',event=>showFile(event.dataTransfer.files?.[0]));document.querySelector('#copyDemoText').addEventListener('click',event=>{document.querySelector('#clipboardText').textContent='Contoh tersalin (simulasi)';event.currentTarget.textContent='Tersalin ✓';setTimeout(()=>event.currentTarget.textContent='Salin contoh',1800)});
  document.querySelectorAll('[data-launch-demo]').forEach(button=>button.addEventListener('click',()=>{document.querySelector('#launcherStatus').textContent=`${button.dataset.launchDemo}: pintasan contoh (tidak dibuka)`;say('Ini contoh launcher saja—nggak membuka aplikasi beneran 🙂')}));document.querySelector('#launcherForm').addEventListener('submit',event=>{event.preventDefault();const name=document.querySelector('#launcherName');const target=document.querySelector('#launcherTarget');document.querySelector('#launcherStatus').textContent=`Pintasan “${name.value}” ditambahkan ke demo`;name.value='';target.value=''});
  const breakToggle=document.querySelector('#breakEnabled');breakToggle.addEventListener('change',()=>document.querySelector('#breakStatus').textContent=breakToggle.checked?`Pengingat aktif · setiap ${document.querySelector('#breakInterval').value}`:'Pengingat mati');document.querySelector('#breakInterval').addEventListener('change',()=>{if(breakToggle.checked)document.querySelector('#breakStatus').textContent=`Pengingat aktif · setiap ${document.querySelector('#breakInterval').value}`});document.querySelector('#breakTest').addEventListener('click',()=>say('Waktunya jeda sebentar 🌿 Regangkan badan, ya!'));document.querySelector('#breakSnooze').addEventListener('click',()=>document.querySelector('#breakStatus').textContent='Pengingat ditunda 10 menit (demo)');document.querySelector('#breakDone').addEventListener('click',()=>document.querySelector('#breakStatus').textContent='Jeda selesai · semangat lagi ✨');
  document.querySelector('#prayerTest').addEventListener('click',()=>say('Waktunya salat 🌙 Ini tes pengingat demo.'));document.querySelector('#prayerMute').addEventListener('click',event=>{const toggle=document.querySelector('#adhanEnabled');toggle.checked=!toggle.checked;event.currentTarget.textContent=toggle.checked?'Mute audio':'Nyalakan audio';say(toggle.checked?'Audio azan demo aktif 🌙':'Audio azan demo dimute 🔇')});document.querySelectorAll('.sub-tab[data-todo-view]').forEach(tab=>tab.addEventListener('click',()=>{document.querySelectorAll('.sub-tab[data-todo-view]').forEach(item=>{const active=item===tab;item.classList.toggle('active',active);item.setAttribute('aria-selected',String(active))});document.querySelector('#todoTasks').hidden=tab.dataset.todoView!=='tasks';document.querySelector('#todoAlarm').hidden=tab.dataset.todoView!=='alarm'}));document.querySelector('#todoForm').addEventListener('submit',event=>{event.preventDefault();const input=document.querySelector('#todoInput');const row=document.createElement('label');row.innerHTML='<input type="checkbox" /><span></span><small>Demo</small>';row.querySelector('span').textContent=input.value;document.querySelector('#todoList').append(row);input.value=''});document.querySelector('#alarmTest').addEventListener('click',()=>say('Bangun sebentar… ini tes alarm demo ⏰'));document.querySelector('#alarmSnooze').addEventListener('click',()=>say('Alarm demo ditunda 5 menit 💤'));
  document.querySelectorAll('.sub-tab[data-journey-view],[data-journey-view]:not(.sub-tab)').forEach(tab=>tab.addEventListener('click',()=>{const view=tab.dataset.journeyView;document.querySelectorAll('.sub-tab[data-journey-view]').forEach(item=>{const active=item.dataset.journeyView===view;item.classList.toggle('active',active);item.setAttribute('aria-selected',String(active))});document.querySelector('#journeyProgress').hidden=view!=='journey';document.querySelector('#journeyCollection').hidden=view!=='collection'}));let xp=280;document.querySelector('#earnXp').addEventListener('click',()=>{xp=Math.min(400,xp+10);document.querySelector('#xpCount').textContent=String(xp);document.querySelector('#xpBar').style.width=`${xp/4}%`;if(xp>=400)document.querySelector('#earnXp').disabled=true;say('Keren, +10 XP! XP tidak dipakai untuk aksesori ✨')});document.querySelectorAll('[data-look]').forEach(button=>button.addEventListener('click',()=>{const group=button.dataset.look;stage.dataset[group]=button.dataset.value;document.querySelectorAll(`[data-look="${group}"]`).forEach(item=>item.classList.toggle('selected',item===button))}));document.querySelectorAll('[data-accessory]').forEach(button=>button.addEventListener('click',()=>{document.querySelector('#activeAccessory').textContent=button.dataset.accessory;document.querySelector('#activeAccessoryIcon').textContent=button.dataset.icon;say(`${button.dataset.accessory} dipakai. XP-mu tetap aman ✨`)}));
  document.querySelector('#sleepDemo').addEventListener('click',event=>{const sleeping=!stage.classList.contains('sleeping');stage.classList.toggle('sleeping',sleeping);setExpression(sleeping?'sleep':'idle',sleeping?'Ssst… aku tidur dulu 💤':'Sudah bangun lagi!');event.currentTarget.textContent=sleeping?'☀ Bangunkan BRAMO':'☾ Coba Sleep Mode'});document.querySelector('#gamingDemo').addEventListener('change',event=>{stage.classList.toggle('gaming',event.currentTarget.checked);if(event.currentTarget.checked){status.textContent='Gaming Focus · mode demo';say('Gaming Focus aktif · indikator ini hanya simulasi 🎮')}else setExpression('idle','Gaming Focus demo dimatikan')});document.querySelector('#fullscreenDemo').addEventListener('click',()=>{document.querySelector('#settingsStatus').textContent='Perilaku fullscreen ditampilkan sebagai contoh saja.';say('Di aplikasi desktop, BRAMO dapat bersembunyi saat fullscreen.')});document.querySelectorAll('#feature-settings .settings-list input').forEach(input=>input.addEventListener('change',()=>{document.querySelector('#settingsStatus').textContent=`${input.closest('label').querySelector('b').textContent}: status preview ${input.checked?'aktif':'mati'}`}));
  const dock=document.querySelector('#webBuddy');const dockHandle=document.querySelector('#webBuddyHandle');const dockTip=document.querySelector('#webBuddyTip');let dockDrag=null;let dockMoved=false;try{const saved=JSON.parse(localStorage.getItem('bramo-site-buddy-position')||'null');if(saved&&Number.isFinite(saved.x)&&Number.isFinite(saved.y)){dock.style.left=`${Math.max(0,Math.min(innerWidth-110,saved.x))}px`;dock.style.top=`${Math.max(0,Math.min(innerHeight-82,saved.y))}px`;dock.style.right='auto';dock.style.bottom='auto'}}catch{}dockHandle.addEventListener('pointerdown',event=>{if(event.button!==0)return;const rect=dock.getBoundingClientRect();dockDrag={id:event.pointerId,dx:event.clientX-rect.left,dy:event.clientY-rect.top,startX:event.clientX,startY:event.clientY};dockMoved=false;dockHandle.setPointerCapture(event.pointerId)});dockHandle.addEventListener('pointermove',event=>{if(!dockDrag||event.pointerId!==dockDrag.id)return;if(Math.hypot(event.clientX-dockDrag.startX,event.clientY-dockDrag.startY)>5){dockMoved=true;dock.classList.add('dragging');const x=Math.max(0,Math.min(innerWidth-dock.offsetWidth,event.clientX-dockDrag.dx));const y=Math.max(0,Math.min(innerHeight-dock.offsetHeight,event.clientY-dockDrag.dy));dock.style.left=`${x}px`;dock.style.top=`${y}px`;dock.style.right='auto';dock.style.bottom='auto'}});function finishDock(){if(!dockDrag)return;if(dockMoved){try{localStorage.setItem('bramo-site-buddy-position',JSON.stringify({x:parseInt(dock.style.left,10),y:parseInt(dock.style.top,10)}))}catch{}}dockDrag=null;dock.classList.remove('dragging');setTimeout(()=>dockMoved=false,0)}dockHandle.addEventListener('pointerup',finishDock);dockHandle.addEventListener('pointercancel',finishDock);dockHandle.addEventListener('click',event=>{if(dockMoved){event.preventDefault();return}document.querySelector('#demo').scrollIntoView({behavior:'smooth',block:'start'});say('Aku di sini! Pilih salah satu dari sepuluh fitur buat dicoba 👋')});document.querySelector('#dismissBuddyTip').addEventListener('click',()=>dockTip.hidden=true);window.addEventListener('resize',()=>{if(dock.style.left){dock.style.left=`${Math.max(0,Math.min(innerWidth-dock.offsetWidth,parseInt(dock.style.left,10)))}px`;dock.style.top=`${Math.max(0,Math.min(innerHeight-dock.offsetHeight,parseInt(dock.style.top,10)))}px`}});setTimeout(()=>{if(dockTip&&!dockTip.hidden)dockTip.hidden=true},9000);
  document.querySelector('#cacheDemo').addEventListener('click',()=>{document.querySelector('#settingsStatus').textContent='Cache demo dibersihkan (tidak ada file yang dihapus).';say('Beres! Cache simulasi sudah dibersihkan ✨')});document.querySelector('#quitDemo').addEventListener('click',()=>{document.querySelector('#settingsStatus').textContent='Di aplikasi desktop, Quit akan menutup BRAMO sepenuhnya.';say('Di situs ini aku tetap di sini kalau kamu butuh 😄')});
</script>
