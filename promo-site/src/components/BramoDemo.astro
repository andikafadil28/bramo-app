          <div class="settings-list"><label><span><b>Mulai bersama Windows</b><small>Buddy siap saat PC menyala</small></span><input type="checkbox" /><i></i></label><label><span><b>Sembunyikan saat fullscreen</b><small>Jeda tampilan saat bermain atau menonton</small></span><input type="checkbox" checked /><i></i></label><label><span><b>Efek suara 8-bit</b><small>Suara kecil untuk interaksi</small></span><input type="checkbox" /><i></i></label><label><span><b>Gaming Focus</b><small>Reaksi dan tampilan khusus game</small></span><input id="gamingDemo" type="checkbox" /><i></i></label></div>
          <div class="settings-extras"><button class="action-secondary" id="sleepDemo" type="button">☾ Coba Sleep Mode</button><button class="action-secondary" id="fullscreenDemo" type="button">⛶ Simulasi fullscreen</button><button class="action-secondary" id="cacheDemo" type="button">Bersihkan cache</button><button class="action-secondary" id="quitDemo" type="button">Keluar</button></div>
          <p class="panel-hint" id="settingsStatus" aria-live="polite">Selain pengaturan tema, semua toggle di sini hanya preview.</p>
