          <div class="toggle-list"><label><input type="checkbox" /><span>Clipboard watcher</span><i></i></label><label><input type="checkbox" /><span>Typing curiosity</span><i></i></label></div>
          <p class="panel-hint">File hanya ditampilkan namanya di browser dan tidak diunggah.</p>
        </section>

        <section class="feature-panel" id="feature-focus" role="tabpanel" aria-labelledby="tab-focus" data-feature-panel="focus" hidden>
          <div class="panel-title"><div><span class="panel-kicker">SESI FOKUS &amp; ISTIRAHAT</span><h3>Pomodoro</h3></div><span class="focus-mode" id="focusMode">FOCUS SESSION</span></div>
          <div class="pomodoro-card"><strong id="focusTime">25:00</strong><i class="focus-progress"><b id="focusProgress"></b></i><div class="pomodoro-actions"><button class="action-primary" id="focusToggle" type="button">Mulai fokus</button><button class="action-secondary" id="focusReset" type="button">Reset</button></div></div>
          <div class="duration-controls"><label>Fokus<select id="focusLength"><option value="15">15 menit</option><option value="25" selected>25 menit</option><option value="45">45 menit</option><option value="60">60 menit</option></select></label><label>Jeda<select id="breakLength"><option value="5" selected>5 menit</option><option value="10">10 menit</option><option value="15">15 menit</option></select></label></div>
          <div class="overwork-row"><label><input type="checkbox" /><span>Ingatkan jika fokus terlalu lama</span></label><select aria-label="Ambang fokus panjang"><option>60 menit</option><option selected>90 menit</option><option>120 menit</option></select></div>
          <p class="panel-hint" id="focusHint" aria-live="polite">Timer demo dipercepat: 30 detik simulasi per detik.</p>
        </section>

        <section class="feature-panel" id="feature-launcher" role="tabpanel" aria-labelledby="tab-launcher" data-feature-panel="launcher" hidden>
          <div class="panel-title"><div><span class="panel-kicker">AKSES CEPAT</span><h3>Launcher</h3></div></div>
          <div class="launcher-grid"><button type="button" data-launch-demo="Catatan"><i>📝</i><span>Catatan</span><small>Contoh aplikasi</small></button><button type="button" data-launch-demo="BRAMO Web"><i>🌐</i><span>BRAMO Web</span><small>Contoh situs</small></button><button type="button" data-launch-demo="Folder kerja"><i>📁</i><span>Folder kerja</span><small>Contoh folder</small></button></div>
          <form class="launcher-form" id="launcherForm"><input type="text" id="launcherName" maxlength="24" placeholder="Nama pintasan" aria-label="Nama pintasan" required /><input type="text" id="launcherTarget" maxlength="80" placeholder="URL atau aplikasi" aria-label="URL atau nama aplikasi" required /><button class="action-primary" type="submit">Tambah</button></form>
          <p class="panel-hint" id="launcherStatus" aria-live="polite">Pintasan baru hanya disimpan sementara di demo ini.</p>
        </section>

        <section class="feature-panel" id="feature-break" role="tabpanel" aria-labelledby="tab-break" data-feature-panel="break" hidden>
          <div class="panel-title"><div><span class="panel-kicker">BIO-RHYTHM BREAK</span><h3>Pengingat Jeda</h3></div><span class="break-icon">☕</span></div>
          <p class="feature-description">Pengingat ringan untuk mengistirahatkan mata dan meregangkan badan.</p>
          <div class="reminder-row"><label class="switch-row"><input id="breakEnabled" type="checkbox" /><span class="switch"></span><b>Pengingat istirahat</b></label><label>Ingatkan setiap<select id="breakInterval"><option>30 menit</option><option>45 menit</option><option selected>60 menit</option><option>90 menit</option></select></label></div>
          <div class="reminder-status" id="breakStatus" aria-live="polite">Pengingat mati</div><div class="reminder-actions"><button class="action-primary" id="breakTest" type="button">Tes bubble jeda</button><button class="action-secondary" id="breakSnooze" type="button">Tunda 10 menit</button><button class="action-secondary" id="breakDone" type="button">Sudah jeda</button></div>
        </section>

        <section class="feature-panel" id="feature-prayer" role="tabpanel" aria-labelledby="tab-prayer" data-feature-panel="prayer" hidden>
          <div class="panel-title"><div><span class="panel-kicker">JADWAL CONTOH · JAKARTA</span><h3>Pengingat Sholat</h3></div><span class="prayer-icon">☪</span></div>
          <div class="next-prayer"><span>Berikutnya</span><strong id="nextPrayerName">Dzuhur</strong><b id="nextPrayerTime">12:04</b></div>
          <div class="prayer-schedule"><span>Subuh <b>04:18</b></span><span>Dzuhur <b>12:04</b></span><span>Ashar <b>15:22</b></span><span>Maghrib <b>17:58</b></span><span>Isya <b>19:08</b></span></div>
          <div class="toggle-list compact-toggles"><label><input id="prayerEnabled" type="checkbox" checked /><span>Pengingat aktif</span><i></i></label><label><input id="adhanEnabled" type="checkbox" checked /><span>Audio azan aktif</span><i></i></label></div>
          <div class="prayer-actions"><button class="action-primary" id="prayerTest" type="button">Tes pengingat</button><button class="action-secondary" id="prayerMute" type="button">Mute audio</button></div>
          <p class="panel-hint">Jadwal di sini hanya contoh, bukan waktu real-time atau lokasi perangkatmu.</p>
        </section>

        <section class="feature-panel" id="feature-todo" role="tabpanel" aria-labelledby="tab-todo" data-feature-panel="todo" hidden>
