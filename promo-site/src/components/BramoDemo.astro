      <div class="control-group"><span class="control-label">WARNA VISOR</span><div class="color-row"><button class="color-chip active" type="button" data-demo-color="#51f7e4" aria-label="Cyan" style="--swatch:#51f7e4"></button><button class="color-chip" type="button" data-demo-color="#70ed9b" aria-label="Matrix Green" style="--swatch:#70ed9b"></button><button class="color-chip" type="button" data-demo-color="#ff65d4" aria-label="Neon Pink" style="--swatch:#ff65d4"></button><button class="color-chip" type="button" data-demo-color="#ffad52" aria-label="Amber" style="--swatch:#ffad52"></button></div></div>
