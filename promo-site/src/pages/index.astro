---
const features = [
  { title: 'Buddy yang terasa hidup', description: 'Ekspresi mata dan mulut, mood, animasi idle, serta reaksi saat kamu bekerja, mengetik, atau memutar musik.', image: '/images/07-living-animations.svg', tag: 'DESKTOP BUDDY' },
  { title: 'Fokus tanpa kehilangan ritme', description: 'Pomodoro yang bisa diatur, timer mini, tracker sesi, dan pengingat saat fokus terlalu lama.', image: '/images/03-focus-pomodoro.svg', tag: 'PRODUCTIVITY' },
  { title: 'Utilitas tepat di desktop', description: 'Kontrol musik, system stats, file drop, clipboard history, dan shortcut aplikasi dalam satu panel ringkas.', image: '/images/04-tools-launcher.svg', tag: 'QUICK TOOLS' },
  { title: 'Jeda yang lebih teratur', description: 'Pengingat bio-rhythm, to-do dengan pengingat, alarm bangun, serta jadwal sholat dan audio azan.', image: '/images/05-break-prayer.svg', tag: 'WELLBEING' },
  { title: 'Tumbuh dan tampil sesuai gaya', description: 'Kumpulkan XP, naik level, buka aksesori, lalu ganti tema visor termasuk RGB dan Red Alert.', image: '/images/06-visor-collection.svg', tag: 'BRAMO JOURNEY' },
  { title: 'Teman kecil saat gaming', description: 'Gaming Focus mengenali game yang didukung atau executable pilihanmu, lalu BRAMO ikut masuk mode fokus.', image: '/images/08-control-and-sleep.svg', tag: 'GAMING FOCUS' },
];

const downloadUrl = 'https://github.com/andikafadil28/bramo-app/releases';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080c12" />
    <meta name="description" content="Kenalan dengan BRAMO, buddy visor LED yang tinggal di desktop. Fokus, utilitas, pengingat, dan personalisasi dalam satu teman kecil." />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="BRAMO — Teman kecil yang tinggal di desktop" />
    <meta property="og:description" content="Buddy visor LED yang nemenin kamu fokus, istirahat, dan menjalani hari." />
    <meta property="og:image" content="/images/01-bramo-buddy.svg" />
    <title>BRAMO — Teman kecil yang tinggal di desktop</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#home" aria-label="BRAMO beranda"><span class="brand-mark">B</span><span>BRAMO<span class="brand-dot">.</span></span></a>
      <nav aria-label="Navigasi utama">
        <a href="#fitur">Fitur</a>
        <a href="#tentang">Tentang</a>
        <a href="#faq">FAQ</a>
      </nav>
      <a class="header-cta" href={downloadUrl} target="_blank" rel="noreferrer">Unduh BRAMO <span>↗</span></a>
    </header>

    <main>
      <section class="hero" id="home">
        <div class="hero-copy">
          <div class="eyebrow"><span class="pulse"></span> DESKTOP COMPANION · WINDOWS</div>
          <h1>Teman kecil yang<br />tinggal di <span>desktop.</span></h1>
          <p>BRAMO bukan cuma widget. Dia buddy visor LED yang nemenin kamu fokus, istirahat, dengerin musik, dan menjalani hari.</p>
          <div class="hero-actions">
            <a class="button primary" href={downloadUrl} target="_blank" rel="noreferrer">Lihat unduhan <span>↓</span></a>
            <a class="button secondary" href="#fitur">Jelajahi fitur <span>↘</span></a>
          </div>
          <div class="hero-meta"><span><i></i> BRAMO 1.0</span><span>Windows 10 / 11</span><span>Gratis digunakan</span></div>
        </div>
        <div class="hero-art" aria-label="Ilustrasi BRAMO sebagai buddy desktop">
          <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
          <div class="hero-glow"></div>
          <img src="/images/01-bramo-buddy.svg" alt="Ilustrasi BRAMO, kapsul visor LED cyberpunk di desktop" />
          <div class="floating-chip chip-top"><span class="chip-dot"></span> READY TO HANG OUT</div>
          <div class="floating-chip chip-bottom">✦ <span>YOUR DESKTOP BUDDY</span></div>
        </div>
        <div class="hero-scroll"><span></span> SCROLL TO EXPLORE</div>
      </section>

      <section class="intro section-wrap" id="tentang">
        <div class="section-kicker">KENALAN DULU</div>
        <div class="intro-grid">
          <h2>Produktif boleh.<br /><span>Ada temannya lebih seru.</span></h2>
          <p>BRAMO tinggal di bagian atas desktop kamu. Buka panel saat butuh alat bantu, biarkan dia bereaksi saat kamu beraktivitas, atau ajak dia istirahat sebentar.</p>
        </div>
        <div class="value-row">
          <div><strong>01</strong><span>Selalu dekat,<br />nggak mengganggu</span></div>
          <div><strong>02</strong><span>Tools harian<br />dalam satu panel</span></div>
          <div><strong>03</strong><span>Buddy yang tumbuh<br />bareng kamu</span></div>
        </div>
      </section>

      <section class="features section-wrap" id="fitur">
        <div class="section-head"><div><div class="section-kicker">YANG BISA BRAMO LAKUKAN</div><h2>Satu buddy.<br /><span>Banyak hal kecil.</span></h2></div><p>Dibuat untuk nemenin keseharian, bukan memenuhi layar. Ilustrasi berikut adalah visual konsep fitur.</p></div>
        <div class="feature-grid">
          {features.map((feature, index) => (
            <article class={`feature-card ${index === 0 ? 'feature-wide' : ''}`}>
              <div class="feature-art"><img src={feature.image} alt={`Ilustrasi fitur BRAMO: ${feature.title}`} loading="lazy" /></div>
              <div class="feature-copy"><span class="feature-tag">{feature.tag}</span><h3>{feature.title}</h3><p>{feature.description}</p></div>
              <span class="feature-index">0{index + 1}</span>
            </article>
          ))}
        </div>
      </section>

      <section class="quote-band">
        <div class="quote-inner"><span class="quote-mark">“</span><p>Kerja fokus, istirahat cukup.<br /><strong>BRAMO nemenin dua-duanya.</strong></p><span class="quote-spark">✳</span></div>
      </section>

      <section class="how section-wrap">
        <div class="section-kicker">MULAI DALAM HITUNGAN MENIT</div><h2>Pasang. Atur. <span>Jalanin harimu.</span></h2>
        <div class="steps"><article><b>01</b><h3>Unduh BRAMO</h3><p>Ambil installer Windows dari halaman rilis resmi.</p></article><article><b>02</b><h3>Atur buddy-mu</h3><p>Pilih tema, aksesori, dan fitur yang mau kamu pakai.</p></article><article><b>03</b><h3>Mulai ditemani</h3><p>Taruh BRAMO di desktop dan buka panel kapan saja.</p></article></div>
        <a class="button primary" href={downloadUrl} target="_blank" rel="noreferrer">Buka halaman unduhan <span>↗</span></a>
      </section>

      <section class="faq section-wrap" id="faq">
        <div><div class="section-kicker">PERTANYAAN UMUM</div><h2>Sebelum mulai.</h2></div>
        <div class="faq-list">
          <details><summary>BRAMO tersedia untuk sistem operasi apa?</summary><p>Versi 1.0 dibuat untuk Windows 10/11. Beberapa integrasi desktop bergantung pada fitur Windows.</p></details>
          <details><summary>Apakah BRAMO gratis?</summary><p>BRAMO dapat digunakan secara gratis. Installer resmi boleh dibagikan gratis sesuai ketentuan lisensi.</p></details>
          <details><summary>Apakah BRAMO mengirim data aktivitas saya?</summary><p>Data preferensi dan progres fitur disimpan di perangkat melalui penyimpanan lokal aplikasi. Pengingat waktu sholat dapat menggunakan lokasi untuk mengambil jadwal dari layanan Aladhan.</p></details>
          <details><summary>Di mana saya bisa melihat kode dan ketentuan lisensinya?</summary><p>Kunjungi <a href="https://github.com/andikafadil28/bramo-app" target="_blank" rel="noreferrer">repository GitHub BRAMO</a> untuk source, dokumentasi, catatan rilis, dan file lisensi.</p></details>
        </div>
      </section>

      <section class="final-cta"><div class="final-glow"></div><div class="section-kicker">DESKTOP KAMU, TEMAN BARU</div><h2>Yuk, kenalan<br />sama <span>BRAMO.</span></h2><p>Buddy kecil untuk hari-hari yang lebih fokus dan lebih berwarna.</p><a class="button primary" href={downloadUrl} target="_blank" rel="noreferrer">Unduh BRAMO <span>↗</span></a></section>
    </main>

    <footer><a class="brand" href="#home"><span class="brand-mark">B</span><span>BRAMO<span class="brand-dot">.</span></span></a><span>© 2026 BRAMO · Dibuat untuk nemenin harimu.</span><div><a href="https://github.com/andikafadil28/bramo-app" target="_blank" rel="noreferrer">GitHub ↗</a><a href="https://github.com/andikafadil28/bramo-app/blob/main/LICENSE" target="_blank" rel="noreferrer">Lisensi</a></div></footer>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; scroll-padding-top: 86px; }
  :global(body) { margin: 0; background: #080c12; color: #e9f1f7; font-family: 'Segoe UI', system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
  :global(a) { color: inherit; text-decoration: none; }
  :global(::selection) { color: #061015; background: #62f4e5; }
  .site-header { height: 76px; padding: 0 clamp(22px, 6vw, 92px); display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(151,193,218,.09); position: absolute; inset: 0 0 auto; z-index: 10; background: rgba(8,12,18,.78); backdrop-filter: blur(16px); }
  .brand { display: inline-flex; align-items: center; gap: 9px; font-size: 17px; font-weight: 800; letter-spacing: -.8px; }.brand-mark { width: 28px; height: 28px; display: grid; place-items: center; color: #071115; border-radius: 8px 8px 11px 11px; background: linear-gradient(145deg,#8efffa,#14b8c5); box-shadow: 0 0 16px #00dce855; font-size: 14px; }.brand-dot { color: #37e8e2; }
  nav { display: flex; gap: clamp(20px, 3vw, 45px); color: #9baebe; font-size: 12px; } nav a:hover, footer a:hover { color: #69f4e9; }
  .header-cta { padding: 10px 15px; border: 1px solid rgba(94,237,227,.32); border-radius: 8px; color: #a4fff7; background: rgba(19,215,207,.07); font-size: 11px; font-weight: 700; }.header-cta span { margin-left: 8px; }
  .hero { min-height: 720px; height: min(860px,100svh); padding: 150px clamp(24px, 9vw, 144px) 75px; display: grid; grid-template-columns: 1fr 1.08fr; align-items: center; gap: 28px; position: relative; overflow: hidden; background: radial-gradient(ellipse at 76% 48%,rgba(0,215,220,.11),transparent 34%), radial-gradient(ellipse at 15% 82%,rgba(76,62,192,.1),transparent 28%), #080c12; }
  .hero::before { content:''; position:absolute; inset:0; opacity:.17; background-image:linear-gradient(rgba(103,157,177,.1) 1px,transparent 1px),linear-gradient(90deg,rgba(103,157,177,.1) 1px,transparent 1px); background-size:56px 56px; mask-image:linear-gradient(to bottom,black,transparent 85%); pointer-events:none; }
  .hero-copy { max-width: 570px; position: relative; z-index: 1; }.eyebrow,.section-kicker { color:#6adfdc; font: 10px 'DM Mono',monospace; letter-spacing:2px; }.pulse { display:inline-block; width:7px;height:7px;margin-right:7px;border-radius:50%;background:#5bffba;box-shadow:0 0 10px #5bffba; }
  h1 { margin: 23px 0 20px; font-size: clamp(48px,6.3vw,82px); line-height:1.04; letter-spacing:-5px; font-weight:700; } h1 span,h2 span { color:#70eee5; }
  .hero-copy>p { max-width: 445px; color:#9eafbe; font-size:15px; line-height:1.8; }
  .hero-actions { display:flex; gap:11px; flex-wrap:wrap; margin-top:29px; }.button { min-height:46px; padding:0 18px; display:inline-flex; align-items:center; justify-content:center; gap:17px; border-radius:8px; font-size:12px; font-weight:700; transition:transform .2s,border .2s,background .2s; }.button:hover { transform:translateY(-2px); }.button.primary { color:#061014; background:linear-gradient(115deg,#8ffaf0,#3bd9d6); box-shadow:0 8px 28px #39e0d526; }.button.secondary { color:#c8d5df; border:1px solid rgba(158,188,204,.2); background:rgba(255,255,255,.025); }
  .hero-meta { display:flex; gap:22px; margin-top:36px; color:#6e8091; font:9px 'DM Mono',monospace; text-transform:uppercase; letter-spacing:.5px; }.hero-meta span:first-child { color:#a6bbc9; }.hero-meta i { display:inline-block;width:6px;height:6px;margin-right:6px;border-radius:50%;background:#64e8c1; }
  .hero-art { min-width:0; position:relative; }.hero-art>img { position:relative;z-index:1;width:100%;display:block;border:1px solid rgba(106,235,226,.17);border-radius:18px;box-shadow:0 24px 90px #0009,0 0 55px #08dad61c; }.hero-glow { position:absolute;inset:14% 13%;background:#00cdd8;filter:blur(85px);opacity:.15; }.orbit { position:absolute;border:1px solid rgba(96,241,231,.12);border-radius:50%;transform:rotate(-19deg); }.orbit-one { width:115%;height:70%;left:-8%;top:15%; }.orbit-two { width:126%;height:88%;left:-13%;top:6%;border-style:dashed;opacity:.5; }.floating-chip { position:absolute;z-index:2;padding:10px 13px;border:1px solid rgba(124,232,229,.2);border-radius:8px;background:#101923eF;color:#7af4e9;box-shadow:0 8px 30px #0005;font:8px 'DM Mono',monospace;letter-spacing:1px; }.chip-top { top:9%;right:-16px; }.chip-bottom { bottom:8%;left:-18px;color:#e7c879; }.chip-dot { display:inline-block;width:6px;height:6px;margin-right:8px;border-radius:50%;background:#66ffcb;box-shadow:0 0 8px #66ffcb; }.hero-scroll { position:absolute;bottom:27px;left:50%;transform:translateX(-50%);color:#657987;font:8px 'DM Mono',monospace;letter-spacing:2px; }.hero-scroll span { display:inline-block;width:26px;height:1px;margin:0 9px 3px 0;background:#42d7d2; }
  .section-wrap { max-width:1160px;margin:0 auto;padding:120px 26px; }.intro { padding-top:135px;padding-bottom:115px; }.intro-grid { display:grid;grid-template-columns:1.1fr .75fr;align-items:end;gap:70px;margin-top:20px; }.intro h2,.section-head h2,.how h2,.faq h2 { margin:0;font-size:clamp(34px,4.4vw,54px);line-height:1.18;letter-spacing:-2.3px; }.intro-grid>p,.section-head>p { margin:0 0 6px;color:#91a2b1;font-size:13px;line-height:1.9; }.value-row { display:grid;grid-template-columns:repeat(3,1fr);margin-top:65px;border-top:1px solid #ffffff16;border-bottom:1px solid #ffffff16; }.value-row>div { min-height:93px;display:flex;align-items:center;gap:19px;padding:18px 5px; }.value-row>div+div { border-left:1px solid #ffffff16;padding-left:26px; }.value-row strong { color:#54ded9;font:12px 'DM Mono',monospace; }.value-row span { color:#adbbc6;font-size:11px;line-height:1.7; }
  .features { padding-top:90px; }.section-head { display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:38px; }.section-head h2 { margin-top:16px; }.section-head>p { max-width:230px; }.feature-grid { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px; }.feature-card { min-width:0;position:relative;overflow:hidden;border:1px solid rgba(135,183,205,.13);border-radius:13px;background:linear-gradient(145deg,#101923,#0c1119);transition:transform .25s,border-color .25s; }.feature-card:hover { transform:translateY(-4px);border-color:#57dad54c; }.feature-wide { grid-column:span 2;display:grid;grid-template-columns:1.22fr .78fr;align-items:center; }.feature-art { overflow:hidden;aspect-ratio:16/9;background:#0b111a; }.feature-art img { display:block;width:100%;height:100%;object-fit:cover;transition:transform .45s; }.feature-card:hover .feature-art img { transform:scale(1.025); }.feature-wide .feature-art { height:100%;aspect-ratio:auto; }.feature-copy { padding:21px 23px 23px; }.feature-tag { color:#61dcd8;font:8px 'DM Mono',monospace;letter-spacing:1.5px; }.feature-copy h3 { margin:10px 0 7px;font-size:18px;letter-spacing:-.5px; }.feature-copy p { max-width:420px;margin:0;color:#8497a7;font-size:11px;line-height:1.8; }.feature-index { position:absolute;top:15px;right:15px;padding:5px 7px;border:1px solid #ffffff1e;border-radius:5px;background:#080c12a8;color:#adc2ce;font:8px 'DM Mono',monospace; }
  .quote-band { padding:55px 24px;border-block:1px solid #ffffff10;background:radial-gradient(ellipse at 50% 100%,#17343970,transparent 62%),#0b1017; }.quote-inner { max-width:850px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:28px; }.quote-mark,.quote-spark { color:#55e0db;font-size:52px;line-height:1; }.quote-inner p { margin:0;text-align:center;color:#b6c5d0;font-size:19px;line-height:1.65; }.quote-inner strong { color:#e9f6fa; }
  .how { text-align:center; }.how h2 { margin-top:17px; }.steps { display:grid;grid-template-columns:repeat(3,1fr);gap:15px;margin:49px 0 33px;text-align:left; }.steps article { min-height:150px;padding:21px;border:1px solid #ffffff14;border-radius:10px;background:#ffffff03; }.steps b { color:#5de2dc;font:10px 'DM Mono',monospace; }.steps h3 { margin:20px 0 7px;font-size:14px; }.steps p { margin:0;color:#8799a8;font-size:11px;line-height:1.7; }.how>.button { margin:auto; }
  .faq { display:grid;grid-template-columns:.7fr 1.3fr;gap:65px;border-top:1px solid #ffffff10; }.faq h2 { margin-top:15px; }.faq-list details { border-bottom:1px solid #ffffff15; }.faq-list summary { padding:18px 28px 18px 0;position:relative;list-style:none;cursor:pointer;color:#d8e2e9;font-size:13px;font-weight:600; }.faq-list summary::-webkit-details-marker { display:none; }.faq-list summary::after { content:'+';position:absolute;right:3px;color:#62e9e1;font-size:18px;font-weight:400; }.faq-list details[open] summary::after { content:'−'; }.faq-list p { margin:0;padding:0 22px 19px 0;color:#8fa1af;font-size:11px;line-height:1.8; }
  .final-cta { position:relative;overflow:hidden;padding:110px 24px 120px;text-align:center;border-top:1px solid #ffffff10;background:radial-gradient(ellipse at 50% 100%,#16b6b840,transparent 60%),#0b1017; }.final-glow { position:absolute;width:320px;height:160px;left:50%;top:45px;transform:translateX(-50%);background:#02d4c9;filter:blur(110px);opacity:.12; }.final-cta>*:not(.final-glow) { position:relative; }.final-cta h2 { margin:17px 0 12px;font-size:clamp(45px,7vw,76px);line-height:1.05;letter-spacing:-4px; }.final-cta p { margin:0 0 25px;color:#93a6b4;font-size:13px; }.final-cta .button { margin:auto; }
  footer { min-height:82px;padding:20px clamp(22px,6vw,92px);display:flex;align-items:center;justify-content:space-between;gap:20px;border-top:1px solid #ffffff12;color:#70818e;font-size:9px; }.brand { color:#e9f1f7; }footer .brand { font-size:14px; }footer .brand-mark { width:23px;height:23px;font-size:11px; }footer>div { display:flex;gap:18px; }
  @media(max-width:850px) { .hero { grid-template-columns:1fr 1fr;padding-inline:6vw; }.hero h1 { letter-spacing:-3px; }.hero-meta { gap:12px; }.intro-grid { gap:30px; }.feature-wide { grid-template-columns:1fr; }.feature-wide .feature-art { aspect-ratio:16/9; }.faq { gap:35px; } }
  @media(max-width:620px) { .site-header { height:65px;padding-inline:18px; }.site-header nav { display:none; }.header-cta { padding:9px 11px;font-size:10px; }.hero { height:auto;min-height:0;padding:125px 22px 75px;grid-template-columns:1fr;gap:40px; }.hero h1 { font-size:53px; }.hero-copy>p { font-size:13px; }.hero-art { margin:0 7px; }.hero-scroll { display:none; }.hero-meta { flex-wrap:wrap;font-size:8px; }.section-wrap { padding:83px 22px; }.intro-grid,.faq { grid-template-columns:1fr;gap:17px; }.intro-grid>p { max-width:470px; }.value-row { margin-top:38px; }.value-row>div { min-height:85px;gap:10px; }.value-row>div+div { padding-left:13px; }.value-row span { font-size:9px; }.section-head { display:block; }.section-head>p { margin-top:15px; }.feature-grid { grid-template-columns:1fr; }.feature-wide { grid-column:auto; }.feature-copy { padding:17px; }.feature-copy h3 { font-size:16px; }.quote-inner { gap:12px; }.quote-inner p { font-size:15px; }.quote-mark,.quote-spark { font-size:32px; }.steps { grid-template-columns:1fr;gap:9px;margin:31px 0 25px; }.steps article { min-height:0;padding:17px; }.steps h3 { margin-top:12px; }.final-cta { padding:85px 20px 93px; }.final-cta h2 { letter-spacing:-2px; }footer { align-items:flex-start;flex-wrap:wrap;padding:20px 22px; }footer>span { order:3;width:100%; } }
  @media(prefers-reduced-motion:reduce) { :global(html) { scroll-behavior:auto; }.button,.feature-card,.feature-art img { transition:none; } }
</style>
